{
  "layer": "top",
  "position": "top",

  "modules-left": ["hyprland/workspaces", "clock"],
  "modules-center": ["window"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery"],

  "clock": {
    "format": " {:%H:%M}"
  },

  "battery": {
    "format": "  {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {percentage}%"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Wired",
    "format-disconnected": " Offline"
  },

  "pulseaudio": {
    "format": " {volume}%"
  }
}
